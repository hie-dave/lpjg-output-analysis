#!/usr/bin/env Rscript

# Compatibility entry point; the implementation is installed with daveanalysis.
args <- commandArgs(trailingOnly = TRUE)
usage <- "Usage: enable_required_outputs -r </path/to/repository>"
if (identical(args, "-h") || identical(args, "--help")) {
    cat(usage, "\n")
    quit(status = 0)
}
if (length(args) != 2L || args[[1]] != "-r") {
    stop(usage, call. = FALSE)
}
daveanalysis::enable_required_outputs(args[[2]])
